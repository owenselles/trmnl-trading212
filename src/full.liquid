<div class="screen">
  <div class="view view--full">
    <div class="layout">

      {% if has_error %}

        <div class="columns">
          <div class="column">
            <div class="markdown content--center">
              <span class="title">Trading212 Error</span>
              <div class="content">{{ error }}</div>
              <div class="content" style="margin-top: 8px;">
                Check your API key and account type in plugin settings.
              </div>
            </div>
          </div>
        </div>

      {% else %}

        <div class="columns">

          <!-- LEFT: Portfolio Summary -->
          <div class="column" style="flex: 0 0 40%;">
            <div class="markdown">

              <span class="label label--underline" style="font-size:14px;">Portfolio</span>

              <div style="margin-top: 6px;">

                <div style="display:flex; justify-content:space-between; align-items:center; padding:5px 0; border-bottom:1px solid #ccc;">
                  <span style="font-size:13px;">Total Value</span>
                  <span style="font-size:13px; font-weight:700;">€{{ total_value }}</span>
                </div>

                {% if has_24h_change %}
                <div style="display:flex; justify-content:space-between; align-items:center; padding:5px 0; border-bottom:1px solid #ccc;">
                  <span style="font-size:13px;">24h Change</span>
                  <span style="font-size:13px; font-weight:700;">€{{ change_24h }} ({{ change_24h_pct }}%)</span>
                </div>
                {% endif %}

                <div style="display:flex; justify-content:space-between; align-items:center; padding:5px 0; border-bottom:1px solid #ccc;">
                  <span style="font-size:13px;">Net Deposits <span style="font-size:11px;">(est.)</span></span>
                  <span style="font-size:13px;">€{{ net_deposits }}</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; padding:5px 0; border-bottom:1px solid #ccc;">
                  <span style="font-size:13px;">Free Cash</span>
                  <span style="font-size:13px;">€{{ free_cash }}</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; padding:5px 0; border-bottom:2px solid #000;">
                  <span style="font-size:13px;">Total Return</span>
                  <span style="font-size:13px; font-weight:700;">€{{ total_return }}</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; padding:5px 0; border-bottom:1px solid #ccc;">
                  <span style="font-size:13px;">Return %</span>
                  <span style="font-size:13px; font-weight:700;">{{ return_pct }}%</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; padding:5px 0; border-bottom:1px solid #ccc;">
                  <span style="font-size:13px;">Positions</span>
                  <span style="font-size:13px;">{{ position_count }}</span>
                </div>

                {% for ex in exchange_statuses %}
                <div style="display:flex; justify-content:space-between; align-items:center; padding:3px 0; {% unless forloop.last %}border-bottom:1px solid #eee;{% endunless %}">
                  <span style="font-size:11px;">{{ ex.name }}</span>
                  <span style="font-size:11px; font-weight:{% if ex.is_open %}700{% else %}400{% endif %};">{{ ex.status }}</span>
                </div>
                {% endfor %}

              </div>
            </div>
          </div>

          <!-- RIGHT: Top Positions by Value -->
          <div class="column" style="flex: 1; border-left: 1px solid #000; padding-left: 14px;">
            <div class="markdown">

              <span class="label label--underline" style="font-size:14px;">Top Positions (by Value)</span>

              {% for p in positions limit: 10 %}
                <div style="display:flex; justify-content:space-between; align-items:center; padding:4px 0; border-bottom:1px solid #ddd;">
                  <span style="flex:0 0 26%; font-size:13px; font-weight:600;">{{ p.ticker }}</span>
                  <span style="flex:0 0 26%; font-size:13px; text-align:right;">€{{ p.current_value }}</span>
                  <span style="flex:1; font-size:13px; text-align:right; padding-right:14px;">{{ p.ppl }}</span>
                </div>
              {% endfor %}

              {% if position_count == 0 %}
                <div class="content" style="font-style:italic; margin-top:16px;">No open positions</div>
              {% endif %}

            </div>
          </div>

        </div>

      {% endif %}

    </div>

    <div class="title_bar">
      <span class="title">Trading212 Portfolio</span>
      <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
    </div>
  </div>
</div>
